<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Percentage Calculator – Calvora</title>

  <meta
    name="description"
    content="Calculate percentages quickly and accurately with Calvora's free Percentage Calculator."
  >

  <!-- Global CSS -->
  <link
    rel="stylesheet"
    href="../../assets/css/style.css"
  >

  <!-- Percentage Calculator CSS -->
  <link
    rel="stylesheet"
    href="./percentage.css"
  >

</head>


<body>


<!-- =====================================================
     HEADER
===================================================== -->

<header id="site-header">

  <div class="logo">

    <a href="../../">
      Calvora
    </a>

  </div>


  <nav class="main-nav">

    <a href="../../">
      Home
    </a>

    <a href="../">
      Calculators
    </a>

    <a href="../../categories/">
      Categories
    </a>

    <a href="../../pages/about.html">
      About
    </a>

    <a href="../../pages/contact.html">
      Contact
    </a>

  </nav>

</header>



<!-- =====================================================
     PERCENTAGE CALCULATOR
===================================================== -->

<main class="percentage-page">


  <section class="percentage-calculator">


    <!-- HEADER -->

    <div class="percentage-header">


      <div class="percentage-icon-box">

        <svg
          viewBox="0 0 48 48"
          fill="none"
          aria-hidden="true"
        >

          <circle
            cx="15"
            cy="15"
            r="5"
            stroke="currentColor"
            stroke-width="3"
          />

          <circle
            cx="33"
            cy="33"
            r="5"
            stroke="currentColor"
            stroke-width="3"
          />

          <path
            d="M35 13L13 35"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
          />

        </svg>

      </div>


      <div>

        <span class="calculator-label">
          MATH CALCULATOR
        </span>

        <h1>
          Percentage Calculator
        </h1>

        <p>
          Calculate percentages quickly and accurately.
        </p>

      </div>

    </div>



    <!-- CALCULATION TYPE -->

    <div class="percentage-type">

      <button
        type="button"
        class="percentage-type-button active"
        data-type="percent-of"
      >
        What is X% of Y?
      </button>


      <button
        type="button"
        class="percentage-type-button"
        data-type="what-percent"
      >
        X is what % of Y?
      </button>


      <button
        type="button"
        class="percentage-type-button"
        data-type="percent-change"
      >
        Percentage Change
      </button>

    </div>



    <!-- FORM -->

    <div class="percentage-form">


      <!-- FIRST INPUT -->

      <div class="input-group">

        <label for="percentageValue">
          Percentage
        </label>

        <div class="input-wrapper">

          <span class="input-prefix">
            %
          </span>

          <input
            type="number"
            id="percentageValue"
            placeholder="Enter percentage"
            step="0.01"
            inputmode="decimal"
          >

        </div>

      </div>



      <!-- SECOND INPUT -->

      <div class="input-group">

        <label for="baseValue">
          Number
        </label>

        <div class="input-wrapper">

          <span class="input-prefix">
            #
          </span>

          <input
            type="number"
            id="baseValue"
            placeholder="Enter number"
            step="0.01"
            inputmode="decimal"
          >

        </div>

      </div>



      <!-- THIRD INPUT -->

      <div
        class="input-group percentage-second-value"
        id="secondValueGroup"
      >

        <label for="secondValue">
          Second Number
        </label>

        <div class="input-wrapper">

          <span class="input-prefix">
            #
          </span>

          <input
            type="number"
            id="secondValue"
            placeholder="Enter second number"
            step="0.01"
            inputmode="decimal"
          >

        </div>

      </div>


    </div>



    <!-- ERROR -->

    <div
      id="percentageError"
      class="percentage-error"
      hidden
    >
      Please enter valid numbers.
    </div>



    <!-- BUTTONS -->

    <div class="percentage-actions">


      <button
        type="button"
        id="calculatePercentage"
        class="percentage-button calculate-percentage-button"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <rect
            x="4"
            y="3"
            width="16"
            height="18"
            rx="2"
            stroke="currentColor"
            stroke-width="2"
          />

          <path
            d="M8 7H16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          />

          <path
            d="M8 11H8.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <path
            d="M12 11H12.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <path
            d="M16 11H16.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <path
            d="M8 15H8.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <path
            d="M12 15H12.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

          <path
            d="M16 15H16.01"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          />

        </svg>

        <span>
          Calculate Percentage
        </span>

      </button>



      <button
        type="button"
        id="resetPercentage"
        class="percentage-button reset-percentage-button"
      >

        <svg
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >

          <path
            d="M20 11A8 8 0 0 0 6.2 5.4L4 8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M4 4V8H8"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M4 13A8 8 0 0 0 17.8 18.6L20 16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

          <path
            d="M20 20V16H16"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />

        </svg>

        <span>
          Reset
        </span>

      </button>

    </div>



    <!-- RESULTS -->

    <section
      id="percentageResults"
      class="percentage-results"
      hidden
    >

      <div class="percentage-result-card">

        <span class="result-label">
          Result
        </span>

        <strong
          id="percentageResult"
          class="result-value"
        >
          —
        </strong>

      </div>


      <div class="percentage-result-card">

        <span class="result-label">
          Calculation
        </span>

        <strong
          id="percentageCalculation"
          class="result-value calculation-result"
        >
          —
        </strong>

      </div>

    </section>



    <!-- INFORMATION -->

    <div class="percentage-info">

      <h2>
        How Percentage Is Calculated
      </h2>

      <p>
        Percentages express a number as a fraction of 100.
        Use this calculator to quickly find percentages,
        compare values, and calculate percentage changes.
      </p>


      <div class="percentage-formula">

        <span>
          Basic Percentage
        </span>

        <strong>
          (Part ÷ Whole) × 100
        </strong>

      </div>


      <div class="percentage-formula">

        <span>
          Percentage of a Number
        </span>

        <strong>
          (Percentage ÷ 100) × Number
        </strong>

      </div>

    </div>


  </section>

</main>



