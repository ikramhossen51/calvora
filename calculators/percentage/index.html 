<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Percentage Calculator – Calvora</title>

  <meta
    name="description"
    content="Free percentage calculator. Calculate percentage of a number, what percentage one number is of another, and percentage change."
  >

  <link rel="stylesheet" href="../../assets/css/style.css">
  <link rel="stylesheet" href="./percentage.css">
</head>

<body>

<header id="site-header">

  <div class="logo">
    <a href="../../">Calvora</a>
  </div>

  <nav class="main-nav">
    <a href="../../">Home</a>
    <a href="../">Calculators</a>
    <a href="../../categories/">Categories</a>
    <a href="../../pages/about.html">About</a>
    <a href="../../pages/contact.html">Contact</a>
  </nav>

</header>


<main class="percentage-page">

  <section class="percentage-calculator">

    <div class="percentage-header">

      <div class="percentage-icon-box">
        <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
          <circle cx="15" cy="15" r="5"
            stroke="currentColor" stroke-width="3"/>
          <circle cx="33" cy="33" r="5"
            stroke="currentColor" stroke-width="3"/>
          <path d="M35 13L13 35"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"/>
        </svg>
      </div>

      <div>
        <span class="calculator-label">MATH CALCULATOR</span>

        <h1>Percentage Calculator</h1>

        <p>Calculate percentages quickly and accurately.</p>
      </div>

    </div>


    <!-- CALCULATION TYPES -->

    <div class="percentage-type">

      <button
        type="button"
        class="percentage-type-button active"
        data-type="percent-of">
        What is X% of Y?
      </button>

      <button
        type="button"
        class="percentage-type-button"
        data-type="what-percent">
        X is what % of Y?
      </button>

      <button
        type="button"
        class="percentage-type-button"
        data-type="percent-change">
        Percentage Change
      </button>

    </div>


    <!-- INPUTS -->

    <div class="percentage-form">

      <div class="input-group" id="percentageGroup">

        <label id="firstLabel" for="percentageValue">
          Percentage
        </label>

        <div class="input-wrapper">

          <span class="input-prefix" id="firstPrefix">%</span>

          <input
            type="number"
            id="percentageValue"
            placeholder="Enter percentage"
            step="any"
            inputmode="decimal"
            autocomplete="off"
          >

        </div>

      </div>


      <div class="input-group">

        <label id="secondLabel" for="baseValue">
          Number
        </label>

        <div class="input-wrapper">

          <span class="input-prefix">#</span>

          <input
            type="number"
            id="baseValue"
            placeholder="Enter number"
            step="any"
            inputmode="decimal"
            autocomplete="off"
          >

        </div>

      </div>


      <div
        class="input-group percentage-third-input"
        id="secondValueGroup"
        hidden
      >

        <label for="secondValue">
          New Number
        </label>

        <div class="input-wrapper">

          <span class="input-prefix">#</span>

          <input
            type="number"
            id="secondValue"
            placeholder="Enter new number"
            step="any"
            inputmode="decimal"
            autocomplete="off"
          >

        </div>

      </div>

    </div>


    <!-- ERROR -->

    <div
      id="percentageError"
      class="percentage-error"
      hidden
      role="alert">
    </div>


    <!-- BUTTONS -->

    <div class="percentage-actions">

      <button
        type="button"
        id="calculatePercentage"
        class="percentage-button calculate-percentage-button">

        <span>Calculate</span>

      </button>

      <button
        type="button"
        id="resetPercentage"
        class="percentage-button reset-percentage-button">

        <span>Reset</span>

      </button>

    </div>


    <!-- RESULTS -->

    <section
      id="percentageResults"
      class="percentage-results"
      hidden>

      <div class="percentage-result-card">

        <span class="result-label">Result</span>

        <strong
          id="percentageResult"
          class="result-value">
          —
        </strong>

      </div>


      <div class="percentage-result-card">

        <span class="result-label">Calculation</span>

        <strong
          id="percentageCalculation"
          class="result-value calculation-result">
          —
        </strong>

      </div>

    </section>


    <!-- INFORMATION -->

    <div class="percentage-info">

      <h2>How Percentage Is Calculated</h2>

      <p>
        Percentages express a number as a fraction of 100.
        Use Calvora to calculate percentages, compare values,
        and find percentage changes.
      </p>

      <div class="percentage-formula">

        <span>Basic Percentage</span>

        <strong>
          (Part ÷ Whole) × 100
        </strong>

      </div>

      <div class="percentage-formula">

        <span>Percentage of a Number</span>

        <strong>
          (Percentage ÷ 100) × Number
        </strong>

      </div>

    </div>

  </section>

</main>


<footer id="site-footer">

  <div class="footer-brand">

    <a href="../../" class="footer-logo">
      Calvora
    </a>

    <p>
      Simple, fast, and free online calculators.
    </p>

  </div>

  <div class="footer-links">

    <div>
      <h4>Explore</h4>
      <a href="../">Calculators</a>
      <a href="../../categories/">Categories</a>
    </div>

    <div>
      <h4>Company</h4>
      <a href="../../pages/about.html">About</a>
      <a href="../../pages/contact.html">Contact</a>
    </div>

  </div>

</footer>


<script src="./percentage.js"></script>

</body>
</html>